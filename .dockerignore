# Keep secrets, local data and build output out of the image's build context.
# Runtime config (GEMINI_API_KEY, NEXTAUTH_SECRET, ...) comes from the
# container's environment at run time, never from a file baked into the image.
.env
.env.*
**/.env
**/.env.*
*.pem

# Local data: the SQLite chat history and the vector store.
data
*.db
*.sqlite
*.sqlite3
*.lance

# Dependencies and build output are rebuilt inside the image.
node_modules
.next
out
build
coverage
*.tsbuildinfo
next-env.d.ts

# Repo and tooling files the image does not need.
.git
.github
.claude
.vercel
.DS_Store
npm-debug.log*
Dockerfile
.dockerignore
